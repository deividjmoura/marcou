# =============================================================================
# Marcou — variáveis de ambiente (Issue #30 PLATFORM)
# =============================================================================
# NUNCA commite valores reais. Use .env.local (ignorado pelo Git).
# Classificação: PUBLIC = segura no bundle do cliente; SECRET = só server-side.
# =============================================================================

# --- PUBLIC (obrigatórias para o app funcionar com Supabase) -----------------
# URL do projeto Supabase (ex.: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable / anon do Supabase (não é service-role)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- SECRET (futuras; não usar NEXT_PUBLIC_*) --------------------------------
# SUPABASE_SERVICE_ROLE_KEY=   # apenas jobs/admin server-side; nunca no browser
# CRON_SECRET=                 # autenticação de jobs agendados (quando existirem)

# Ver matriz completa e procedimentos em docs/PLATFORM.md
