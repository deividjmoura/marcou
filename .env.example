# =============================================================================
# Marcou — variáveis de ambiente (Issue #30 PLATFORM)
# =============================================================================
# NUNCA commite valores reais. Use .env.local (ignorado pelo Git).
# Classificação:
#   PUBLIC      = segura no bundle do cliente (prefixo NEXT_PUBLIC_*)
#   SERVER-ONLY = apenas servidor/jobs; NUNCA usar NEXT_PUBLIC_* nem no browser
# Matriz completa e procedimentos operacionais em docs/PLATFORM.md.
# =============================================================================

# --- PUBLIC (obrigatórias para o app funcionar com Supabase) -----------------
# Origem pública do app. Em ambientes publicados (Netlify), configure a origem
# exata do contexto (produção, Deploy Preview ou Branch Deploy). Ver docs/IDENTITY.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL do projeto Supabase (ex.: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable / anon do Supabase (NÃO é service-role)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- SERVER-ONLY / SECRET (opcionais; nunca no cliente nem no Git) -----------
# Chave service-role do Supabase (usada apenas em GET /api/cron e worker Calendar)
# SUPABASE_SERVICE_ROLE_KEY=

# Token bearer para o scheduler externo de lembretes (GET /api/cron)
# CRON_SECRET=

# Token bearer opcional para modo profundo de saúde (GET /api/health?deep=1)
# HEALTH_CHECK_SECRET=

# Diagnóstico opt-in de latência de autenticação no servidor (sem PII; "1" ativa)
# AUTH_TIMING_LOG=

# --- GOOGLE CALENDAR (desativado por padrão; ver docs/CALENDAR-INTEGRATION.md)
# GOOGLE_CALENDAR_ENABLED=false
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# GOOGLE_CALENDAR_WORKER_SECRET=

# --- E-MAIL TRANSACIONAL (desativado por padrão; ver docs/ADR-EMAIL-PROVEDOR.md)
# Somente modo noop/log existe até aprovação de provedor pelo responsável (#26).
# EMAIL_DELIVERY_ENABLED=false
# EMAIL_PROVIDER=noop

# --- AUTH RECOVERY (metadados públicos de build; ver docs/AUTH-RECOVERY-PREVIEW-ORIGIN.md)
# A Netlify expõe CONTEXT e DEPLOY_PRIME_URL no build. next.config.ts copia esses
# metadados públicos para o bundle como MARCOU_AUTH_DEPLOY_CONTEXT e
# MARCOU_AUTH_DEPLOY_PRIME_URL. Não defina a partir de headers da requisição,
# input do usuário ou Host manual.
