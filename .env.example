# Public app origin and Supabase settings (never commit real credentials)
# Local development only; production auth redirects are pinned to the canonical URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Netlify provides CONTEXT and DEPLOY_PRIME_URL at runtime for Deploy Previews.
# Do not override these with user/request-derived values. Production uses the canonical origin.
# CONTEXT=deploy-preview
# DEPLOY_PRIME_URL=https://deploy-preview-123--marcoou.netlify.app
